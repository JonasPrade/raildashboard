// Base model of the flexible profile `rail_flex`. It admits every track the request
// switches can turn on: every track class the router imports (rail, light_rail, subway,
// tram, narrow_gauge, and OTHER = a planned track without a track type) in every
// lifecycle status. The backend narrows it per request with a query custom model
// (dashboard_backend/services/routing_networks.py). A query model can only lower
// priorities, so this base must stay the widest network a request may ask for.
{
  "distance_influence": 0,
  "priority": [
    { "if": "!rail_access || railway_class == FUNICULAR", "multiply_by": "0" }
  ],
  "speed": [
    { "if": "true", "limit_to": "rail_average_speed" }
  ]
}
