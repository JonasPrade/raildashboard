# .env.prod.example – Docker production environment variables
#
# Copy to /srv/raildashboard/.env on the server and fill in the values. Deploys run
# through deploy/prod.sh (DEPLOY.md); it pulls the images and runs `docker compose up -d`.
#
# Differences from plain .env:
#   - DATABASE_URL uses "db" as the hostname (Docker service name, not localhost)
#   - DB_USER / DB_PASSWORD are used by compose.yaml to create the Postgres user
#   - BACKEND_CORS_ORIGINS must include the real public domain
#   - IMAGE_TAG pins the commit SHA whose GHCR images run. release.yml builds and
#     pushes them; the server only pulls. deploy/prod.sh sets IMAGE_TAG on each deploy.

# ---------------------------------------------------------------------------
# Release pin — full 40-character commit SHA of the images to run for every service
# (ghcr.io/jonasprade/raildashboard-<svc>:${IMAGE_TAG}). prod.sh overwrites this
# line on each deploy and rolls back to the previous value; it only accepts SHAs.
# ---------------------------------------------------------------------------
IMAGE_TAG=0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Docker-compose DB bootstrap (used by the `db` and `backup` services in compose.yaml)
# ---------------------------------------------------------------------------
DB_USER=raildashboard
DB_PASSWORD=change-me-in-production
# Pre-migration dumps kept in backups/ by the one-shot `backup` service (default 10).
BACKUP_KEEP=10
# Optional: Healthchecks.io check URL pinged by prod.sh (/start, success, /fail).
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Postgres connection — assembled automatically from DB_USER + DB_PASSWORD in compose.yaml.
# Do NOT set DATABASE_URL manually here; it would override the auto-assembled value.

# CORS — list the public URL(s) that the browser will use to reach the app
# BACKEND_CORS_ORIGINS=["https://your-domain.com"]

# SQLAlchemy connection pool (optional — defaults shown). The backend runs 2 uvicorn
# workers, so the worst case is 2 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) connections;
# keep that under the Postgres max_connections budget.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=1800

# ERA RINF API (optional — only needed for RINF data imports)
RINF_API_URL=https://rinf.era.europa.eu/api
RINF_USERNAME=
RINF_PASSWORD=

# Routing microservice — uses the "graphhopper" Docker service name (not localhost).
# Increment GRAPH_VERSION whenever you deploy a new OSM extract to bust the route cache.
ROUTING_BASE_URL=http://graphhopper:8989
ROUTING_TIMEOUT_SECONDS=20
GRAPH_VERSION=1

# OSM PBF extract URL — GraphHopper downloads this automatically on first start if the
# graph cache volume (ghdata) is empty. Leave blank to skip GraphHopper.
# Source: https://download.geofabrik.de/
# Germany (~4 GB): https://download.geofabrik.de/europe/germany-latest.osm.pbf
GH_OSM_URL=

# Session secret key — used to HMAC-sign httpOnly session cookies. Must be set in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-generate-a-random-32-byte-hex-string

# Celery task queue — hostname is the Docker service name "redis" (internal Docker network, not exposed to host)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM API for optional AI extraction (VIB import and future features).
# Supports any OpenAI-compatible endpoint: OpenAI, Ollama, Azure OpenAI, Mistral, etc.
# Leave LLM_BASE_URL empty to disable AI extraction entirely.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Mistral OCR — shared stage 1 of every PDF import. Leave OCR_API_KEY empty to
# fall back to pymupdf text extraction.
OCR_API_KEY=
OCR_BASE_URL=https://api.mistral.ai
OCR_MODEL=mistral-ocr-latest

# Haushalt import: which extraction feeds the parser — pdfplumber (default),
# compare (both run, pdfplumber supplies the values, diff recorded) or ocr.
# Do not set "ocr" in production: the comparison against the real API (2026-09-10,
# mistral-ocr-latest) found 34 of 141 rows missing and 79 differing values.
HAUSHALT_EXTRACTION=pdfplumber

# MCP endpoint (/mcp) for AI assistants such as Claude Code, authenticated with
# personal API keys created under /admin/api-keys. false = route not mounted.
MCP_ENABLED=true

# ---------------------------------------------------------------------------
# Frontend (baked into the JS bundle at docker compose build time)
# ---------------------------------------------------------------------------

# Empty → API calls use a relative path (/api/...) and nginx proxies them to the backend.
# Set this to the full public URL only if you are NOT routing through nginx
# (e.g. VITE_API_BASE_URL=https://api.your-domain.com).
VITE_API_BASE_URL=

# Raster tile layer URL for the map
REACT_APP_TILE_LAYER_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
